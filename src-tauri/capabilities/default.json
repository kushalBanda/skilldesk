{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. The UI never touches files; the Rust core does.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-start-dragging", "dialog:allow-open", "updater:default", "process:allow-restart"]
}
